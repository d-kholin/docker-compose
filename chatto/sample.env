# Chatto Configuration
# These values go into the Portainer stack environment (stack.env) — not committed to git.

# Public domains — Caddy proxies both; DNS for each must point at this host
CHATTO_DOMAIN=chat.thegriffiths.ca
CHATTO_LIVEKIT_DOMAIN=livekit.chat.thegriffiths.ca

# Comma-separated verified emails that become Chatto owners on first login
CHATTO_OWNERS_EMAILS=<changeme>

# File ownership inside the container
PUID=1000
PGID=1000

# Shared secret between chatto-nats and the chatto client (generate with: openssl rand -hex 32)
CHATTO_NATS_TOKEN=<changeme>

# Cookie / core secrets (generate each with: openssl rand -hex 32)
CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET=<changeme>
CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET=<changeme>
CHATTO_CORE_SECRET_KEY=<changeme>
CHATTO_CORE_ASSETS_SIGNING_SECRET=<changeme>

# LiveKit (voice/video calls) — API key is just an identifier, must match
# webhook.api_key in livekit.yaml. Secret must be at least 32 characters
# (generate with: openssl rand -hex 32) and must also match livekit.yaml if
# you set it there instead of relying on the LIVEKIT_KEYS env var.
CHATTO_LIVEKIT_API_KEY=chatto
CHATTO_LIVEKIT_API_SECRET=<changeme>

# SMTP — required for email/password registration, verification, and password reset
CHATTO_SMTP_ENABLED=true
CHATTO_SMTP_HOST=<changeme>
CHATTO_SMTP_PORT=587
# mandatory (STARTTLS on 587) or implicit (TLS/SMTPS on 465)
CHATTO_SMTP_TLS=mandatory
CHATTO_SMTP_USERNAME=<changeme>
CHATTO_SMTP_PASSWORD=<changeme>
CHATTO_SMTP_FROM=noreply@thegriffiths.ca
