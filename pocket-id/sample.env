# Pocket ID Configuration
# These values go into the Portainer stack environment (stack.env) — not committed to git.

# Public URL — passkeys are bound to this domain, changing it later invalidates them
APP_URL=https://sso.thegriffiths.ca

# Behind the Caddy reverse proxy (TLS terminated there)
TRUST_PROXY=true

# Encryption key for sensitive data at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=<changeme>

# File ownership inside the container
PUID=1000
PGID=1000

# Timezone
TZ=America/Edmonton

# SMTP — enables login notification and one-time access emails
SMTP_HOST=<changeme>
SMTP_PORT=587
SMTP_FROM=<changeme>
SMTP_USER=<changeme>
SMTP_PASSWORD=<changeme>
# One of: none, starttls, tls
SMTP_TLS=starttls
